# Copy this file to .env.local and fill in the values.
# Supabase dashboard → Project Settings → API Keys

# Public: safe in the browser (the NEXT_PUBLIC_ prefix sends it to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Secret: server only. Never add NEXT_PUBLIC_ to it and never commit it.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# The public address of the site, used for SEO links. Optional in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
